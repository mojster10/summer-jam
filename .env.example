# ─────────────────────────────────────────────────────────────
# Hidrant LJ — okoljske spremenljivke
# Aplikacija deluje BREZ ključev (uporablja vgrajeno bazo hidrantov
# in brezplačni OpenStreetMap Nominatim za geokodiranje naslovov).
# ─────────────────────────────────────────────────────────────

# Kontaktni e-naslov za Nominatim (priporočljivo po njihovih pravilih rabe).
# Če ni nastavljen, se uporabi splošna vrednost.
NOMINATIM_EMAIL=

# (Neobvezno) Če želiš uporabiti pravo bazo (Postgres / Supabase) namesto
# vgrajenega nabora podatkov, nastavi povezavo in prilagodi lib/db.js.
# DATABASE_URL=
