# ─────────────────────────────────────────────────────────────
# Sanjski vikend planer — API ključi (drži jih SAMO na strežniku)
# Kopiraj v .env.local in izpolni. Brez ključev app deluje s privzetimi
# (mock) cenami in prikaže opozorilo "cene morda niso aktualne".
# ─────────────────────────────────────────────────────────────

# ✈️ LETI + 🏨 HOTEL — Amadeus for Developers
# Registracija: https://developers.amadeus.com/  → Self-Service → nova aplikacija.
# Dobiš API Key (client_id) in API Secret (client_secret).
# Privzeto se uporablja test okolje (test.api.amadeus.com).
# Za produkcijske cene nastavi AMADEUS_BASE_URL=https://api.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# 🍽️ HRANA — Google Places API (Text Search)
# https://console.cloud.google.com/  → omogoči "Places API" → ustvari API ključ.
GOOGLE_PLACES_API_KEY=

# 🎉 ZABAVA — Ticketmaster Discovery API
# https://developer.ticketmaster.com/  → registracija → Consumer Key.
TICKETMASTER_API_KEY=
